{
    "serial_port": "/dev/ttyUSB0",
    "serial_baud": 115200,
    "display_width": 480,
    "display_height": 320,

    "font_family": "DejaVu Sans",
    "font_family_mono": "DejaVu Sans Mono",
    "font_size_large": 15,
    "font_size_normal": 12,
    "font_size_small": 10,
    "font_size_icon": 14,

    "bg_color":          "#1B1B1F",
    "card_color":        "#25252D",
    "topbar_color":      "#141418",
    "nav_color":         "#141418",
    "fg_color":          "#E8E8E8",
    "fg_dim_color":      "#888899",
    "accent_color":      "#67AB9F",
    "accent_dark_color": "#3D7A72",
    "online_color":      "#4CAF50",
    "warning_color":     "#FF9800",
    "error_color":       "#EF5350",
    "sent_bubble_color": "#2A4A46",
    "recv_bubble_color": "#2C2C35",

    "max_messages": 100,
    "node_timeout_sec": 300,
    "refresh_interval_ms": 500,
    "node_name": "MESH-PI"
}
